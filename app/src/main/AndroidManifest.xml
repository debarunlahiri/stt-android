<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-feature android:name="android.hardware.type.watch" android:required="false" />

    <application
        android:name=".SttApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.STT"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.STT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".ui.screen.HomeActivity"
            android:exported="false"
            android:label="STT Service"
            android:theme="@style/Theme.STT" />
            
        <activity
            android:name=".ui.screen.TranscriptionActivity"
            android:exported="false"
            android:label="Voice Transcription"
            android:theme="@style/Theme.STT"
            android:parentActivityName=".ui.screen.HomeActivity" />
            
        <activity
            android:name=".ui.screen.TranslationActivity"
            android:exported="false"
            android:label="Text Translation"
            android:theme="@style/Theme.STT"
            android:parentActivityName=".ui.screen.HomeActivity" />
            
        <activity
            android:name=".ui.screen.LanguageDetectionActivity"
            android:exported="false"
            android:label="Language Detection"
            android:theme="@style/Theme.STT"
            android:parentActivityName=".ui.screen.HomeActivity" />
            
        <activity
            android:name=".ui.screen.MessengerActivity"
            android:exported="false"
            android:label="Send to Messenger"
            android:theme="@style/Theme.STT"
            android:parentActivityName=".ui.screen.HomeActivity" />
    </application>

</manifest>