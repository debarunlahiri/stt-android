<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Localhost and loopback -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- Android emulator -->
        <domain includeSubdomains="true">10.0.2.2</domain>

        <!-- Common 192.168.0.x range -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.0.65</domain>
        <domain includeSubdomains="true">192.168.0.100</domain>
        <domain includeSubdomains="true">192.168.0.101</domain>
        <domain includeSubdomains="true">192.168.0.102</domain>
        <domain includeSubdomains="true">192.168.0.157</domain>

        <!-- Common 192.168.1.x range -->
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">192.168.1.101</domain>
        <domain includeSubdomains="true">192.168.1.102</domain>

        <!-- Common 10.0.0.x range -->
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.2</domain>
        <domain includeSubdomains="true">10.0.0.100</domain>

        <!-- Common 10.0.1.x range -->
        <domain includeSubdomains="true">10.0.1.1</domain>
        <domain includeSubdomains="true">10.0.1.100</domain>

        <!-- Private network range 172.16.x.x -->
        <domain includeSubdomains="true">172.16.0.1</domain>
        <domain includeSubdomains="true">172.16.0.100</domain>
    </domain-config>
</network-security-config>